#!/usr/bin/env python3
"""
Assign one supermarket-aisle label to every Mealie food, with Claude choosing the label.
Runs as-is from Unraid User Scripts (python3, stdlib only).
Missing labels from the 15 below are created first (existing ones are reused by exact name).

1. Fill in MEALIE_URL, MEALIE_TOKEN and ANTHROPIC_API_KEY below.
2. Run with APPLY = False: Claude decides, decisions are printed and saved to CACHE_FILE, nothing changes in Mealie.
3. Review the output. To override a decision, edit CACHE_FILE (food name in lower case -> label).
4. Set APPLY = True, LIMIT = 1, run, check that food in Mealie. Then LIMIT = 0 and run again.
   Cached decisions are reused, so only foods Claude hasn't seen before cost an API call.
"""
import json, os, sys, time, urllib.error, urllib.request

MEALIE_URL = "CHANGE-ME"                           # e.g. http://192.168.10.20:3010, no trailing /api
MEALIE_TOKEN = "CHANGE-ME"                         # Mealie > User Profile > API Tokens
ANTHROPIC_API_KEY = "CHANGE-ME"                    # console.anthropic.com > API Keys
MODEL = "claude-haiku-5-5"                         # cheap and plenty for this job
APPLY = False                                      # False = dry run (prints only)
LIMIT = 0                                          # 0 = all; e.g. 1 for a single-food test
ONLY_UNLABELLED = True                             # False = also re-check foods that already have a label
BATCH_SIZE = 100                                   # foods per Claude request
CACHE_FILE = "/mnt/user/appdata/mealie-labels/ai_labels.json"

# In shop walking order (reorder in Mealie's shopping list view).
LABEL_COLORS = {
    "Fruit & Veg": "#4caf50",
    "Herbs & Spices": "#8bc34a",
    "Pasta & Rice": "#ffc107",
    "Meat & Fish": "#b71c1c",
    "Chilled & Deli": "#3f51b5",
    "Dairy": "#fdd835",
    "Baking": "#ff9800",
    "Tins & Jars": "#9e9e9e",
    "Sauces & Condiments": "#e53935",
    "Snacks & Sweets": "#e91e63",
    "Household": "#8d6e63",
    "Toiletries": "#ba68c8",
    "Bakery": "#c68642",
    "Frozen": "#80deea",
    "Drinks": "#03a9f4",
}
LABELS = list(LABEL_COLORS)

SYSTEM = """You sort grocery items into the aisle of a UK discount supermarket (Lidl/Aldi) so a shopping list follows the store layout.
Pick exactly one label per item from the allowed list. Names may be US-style (cilantro = coriander, zucchini = courgette, ground beef = mince, eggplant = aubergine) or include packaging words like "pkg"; judge by the food itself.
Guidance:
- Fruit & Veg: fresh produce and fresh herbs, incl. bagged salad.
- Bakery: bread, wraps, tortillas, pitta, muffins.
- Tins & Jars: tinned veg/beans/fish/tomatoes, olives, nut butters, honey, jarred pickles.
- Pasta & Rice: dry pasta, rice, noodles, grains, couscous, lentils, oats, breakfast cereal.
- Sauces & Condiments: ketchup, mayo, dressings, vinegars, soy/fish sauce, pastes, pesto, jarred cooking sauces.
- Baking: flour, sugar, baking powder/soda, cornflour, cocoa, baking chocolate, vanilla, syrups, oils, stock, nuts, seeds, dried fruit.
- Herbs & Spices: dried herbs, ground and whole spices, spice blends and seasonings, salt, pepper. Fresh herbs stay in Fruit & Veg.
- Snacks & Sweets: crisps, chocolate bars, biscuits, sweets.
- Drinks: juice, soft drinks, water, alcohol, tea, coffee.
- Meat & Fish: fresh raw meat and poultry, fresh or smoked fish and seafood.
- Dairy: milk (incl. plant milk), butter, cream, yoghurt, eggs, cheese.
- Chilled & Deli: cooked/cured meats, hummus, dips, fresh pasta, gnocchi, tofu/tempeh, chilled meat-free.
- Frozen: anything frozen.
- Household: cleaning products, kitchen roll, foil, bin bags, other non-food household items.
- Toiletries: personal care (toothpaste, shampoo, soap, deodorant), medicines and first aid.
Return every item via the assign_labels tool, using the index given for each item."""


def key(s):
    return s.strip().lower()


class Mealie:
    def __init__(self, base, token):
        self.base, self.token = base.rstrip("/"), token

    def req(self, method, path, body=None):
        data = None if body is None else json.dumps(body).encode()
        for attempt in range(3):
            r = urllib.request.Request(self.base + path, data=data, method=method)
            r.add_header("Authorization", "Bearer " + self.token)
            r.add_header("Accept", "application/json")
            if data is not None:
                r.add_header("Content-Type", "application/json")
            try:
                with urllib.request.urlopen(r, timeout=60) as resp:
                    raw = resp.read()
                    return json.loads(raw) if raw else None
            except urllib.error.HTTPError as e:
                if e.code in (429, 500, 502, 503) and attempt < 2:
                    time.sleep(2 * (attempt + 1)); continue
                sys.exit(f"HTTP {e.code} on {method} {path}: {e.read().decode(errors='replace')[:300]}")
            except urllib.error.URLError as e:
                if attempt < 2:
                    time.sleep(2); continue
                sys.exit(f"Cannot reach {self.base}: {e}")

    def paged(self, path):
        out, page = [], 1
        while True:
            d = self.req("GET", f"{path}?perPage=500&page={page}")
            out += d["items"]
            if page >= d.get("total_pages", 1):
                return out
            page += 1

    def foods(self):
        return self.paged("/api/foods")

    def labels(self):
        return self.paged("/api/groups/labels")

    def create_label(self, name, color):
        return self.req("POST", "/api/groups/labels", {"name": name, "color": color})

    def set_label(self, food, label_id):
        body = {k: v for k, v in food.items() if k not in ("label", "createdAt", "updatedAt", "recipeCount")}
        body["labelId"] = label_id
        self.req("PUT", f"/api/foods/{food['id']}", body)


def ask_claude(names):
    """Return {lowercase name: label} for a batch of food names."""
    tool = {
        "name": "assign_labels",
        "description": "Record the supermarket aisle label for each item.",
        "input_schema": {
            "type": "object",
            "properties": {"assignments": {"type": "array", "items": {
                "type": "object",
                "properties": {"i": {"type": "integer"}, "label": {"type": "string", "enum": LABELS}},
                "required": ["i", "label"]}}},
            "required": ["assignments"],
        },
    }
    body = {
        "model": MODEL, "max_tokens": 8192, "system": SYSTEM,
        "tools": [tool], "tool_choice": {"type": "tool", "name": "assign_labels"},
        "messages": [{"role": "user", "content": "Items:\n" + "\n".join(f"{i}: {n}" for i, n in enumerate(names))}],
    }
    data = json.dumps(body).encode()
    for attempt in range(4):
        r = urllib.request.Request("https://api.anthropic.com/v1/messages", data=data, method="POST")
        r.add_header("x-api-key", ANTHROPIC_API_KEY)
        r.add_header("anthropic-version", "2023-06-01")
        r.add_header("content-type", "application/json")
        try:
            with urllib.request.urlopen(r, timeout=180) as resp:
                out = json.loads(resp.read())
            break
        except urllib.error.HTTPError as e:
            if e.code in (429, 500, 502, 503, 529) and attempt < 3:
                time.sleep(5 * (attempt + 1)); continue
            sys.exit(f"Claude API HTTP {e.code}: {e.read().decode(errors='replace')[:300]}")
        except urllib.error.URLError as e:
            if attempt < 3:
                time.sleep(5); continue
            sys.exit(f"Cannot reach Claude API: {e}")
    result = {}
    for block in out.get("content", []):
        if block.get("type") == "tool_use":
            for a in block["input"].get("assignments", []):
                i, label = a.get("i"), a.get("label")
                if isinstance(i, int) and 0 <= i < len(names) and label in LABELS:
                    result[key(names[i])] = label
    return result


def load_cache():
    try:
        with open(CACHE_FILE) as fh:
            cache = json.load(fh)
    except FileNotFoundError:
        return {}
    return {k: v for k, v in cache.items() if v in LABELS}   # drop decisions using retired labels


def save_cache(cache):
    os.makedirs(os.path.dirname(CACHE_FILE) or ".", exist_ok=True)
    with open(CACHE_FILE, "w") as fh:
        json.dump(dict(sorted(cache.items())), fh, indent=1, ensure_ascii=False)


def main():
    if "CHANGE-ME" in (MEALIE_URL + MEALIE_TOKEN + ANTHROPIC_API_KEY):
        sys.exit("Fill in MEALIE_URL, MEALIE_TOKEN and ANTHROPIC_API_KEY at the top of the script first.")
    api = Mealie(MEALIE_URL, MEALIE_TOKEN)
    foods = api.foods()

    ids = {l["name"]: l["id"] for l in api.labels()}
    for name in LABELS:
        if name in ids:
            continue
        if APPLY:
            ids[name] = api.create_label(name, LABEL_COLORS[name])["id"]
            print(f"  created label: {name}")
        else:
            ids[name] = f"(new {name})"
            print(f"  would create label: {name}")

    if APPLY:   # confirm all 15 really exist in Mealie before carrying on
        now = {l["name"] for l in api.labels()}
        missing = [n for n in LABELS if n not in now]
        if missing:
            sys.exit(f"Mealie is missing labels after creating them: {', '.join(missing)}")
        print(f"  all {len(LABELS)} labels present in Mealie")

    current_ids = {ids[n] for n in LABELS}
    # Foods on a label not in LABELS count as unlabelled.
    candidates = [f for f in foods if not (ONLY_UNLABELLED and f.get("labelId") in current_ids)]
    cache = load_cache()
    todo = sorted({f["name"] for f in candidates if key(f["name"]) not in cache}, key=str.lower)
    print(f"{len(foods)} foods, {len(candidates)} to check, {len(todo)} need Claude. "
          f"{'APPLYING' if APPLY else 'DRY RUN (nothing will change in Mealie)'}")

    for start in range(0, len(todo), BATCH_SIZE):
        batch = todo[start:start + BATCH_SIZE]
        print(f"  asking Claude about {start + 1}-{start + len(batch)} of {len(todo)}...")
        cache.update(ask_claude(batch))
        save_cache(cache)

    done = skipped = 0
    unanswered = []
    for f in sorted(candidates, key=lambda x: x["name"].lower()):
        label = cache.get(key(f["name"]))
        if label not in LABELS:
            unanswered.append(f["name"])
            continue
        label_id = ids[label]
        if f.get("labelId") == label_id:
            skipped += 1
            continue
        if LIMIT and done >= LIMIT:
            break
        print(f"  {f['name']} -> {label}")
        if APPLY:
            api.set_label(f, label_id)
        done += 1
    print(f"{'Updated' if APPLY else 'Would update'} {done}, already correct {skipped}, no answer {len(unanswered)}.")
    for n in unanswered:
        print(f"  no answer (re-run to retry): {n}")


if __name__ == "__main__":
    main()
