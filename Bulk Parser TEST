#!/usr/bin/env python3
import json, random, sys, urllib.request, functools
print = functools.partial(print, flush=True)

BASE = "http://x.x.x.x:3010"
TOKEN = "<your token>"
SAMPLE = 5

# US/imperial unit -> (factor, UK unit)
CONVERT = {
    "ounce": (28.35, "g"), "oz": (28.35, "g"),
    "pound": (453.59, "g"), "lb": (453.59, "g"),
    "cup": (240, "ml"),
    "fluid ounce": (29.57, "ml"), "fl oz": (29.57, "ml"),
    "pint": (473, "ml"), "quart": (946, "ml"), "gallon": (3785, "ml"),
}

def call(path, method="GET", data=None):
    req = urllib.request.Request(
        BASE + path, method=method,
        data=json.dumps(data).encode() if data else None,
        headers={"Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.loads(r.read())
    except Exception as e:
        print(f"!! FAILED on {method} {path}: {e}")
        sys.exit(1)

print(f"Dry run - parsing {SAMPLE} random recipes, NOTHING is saved\n")
slugs = [r["slug"] for r in call("/api/recipes?perPage=-1&page=1")["items"]]
print(f"Found {len(slugs)} recipes\n")

for slug in random.sample(slugs, SAMPLE):
    recipe = call(f"/api/recipes/{slug}")
    lines = [i.get("note") or i.get("originalText") or "" for i in recipe["recipeIngredient"]]
    lines = [l for l in lines if l.strip()]
    print("=" * 70)
    print(f"RECIPE: {recipe['name']}  ({slug})")
    print("=" * 70)
    if not lines:
        print("  (no ingredients)\n")
        continue

    res = call("/api/parser/ingredients", "POST", {"parser": "nlp", "ingredients": lines})
    for r in res:
        ing = r["ingredient"]
        qty = ing.get("quantity") or 0
        unit = (ing.get("unit") or {}).get("name") or ""
        food = (ing.get("food") or {}).get("name") or "NONE"
        qty_s = f"{qty:g}" if qty else "-"
        print(f"  {r['input']}")
        print(f"      ----> qty: {qty_s} | unit: {unit or '-'} | food: {food}")
        if unit.lower() in CONVERT and qty:
            f, uk = CONVERT[unit.lower()]
            print(f"      ----> UK: {qty * f:.0f} {uk}   (converted from {qty_s} {unit})")
        elif unit.lower() in CONVERT:
            print(f"      ----> UK: needs conversion from {unit} to {CONVERT[unit.lower()][1]}")
        if not ing.get("food"):
            print(f"      ----> WARNING: no food matched")
    print()

print("Done. Nothing was changed.")
